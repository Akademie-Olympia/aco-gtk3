/* Generated by aco-theme from ~/.config/gtk-3.0/aco-theme/theme.css.tpl. Do not edit.
 * Recolours Adwaita (light or dark, chosen by aco-theme) with the ACO palette. */
@define-color theme_fg_color {{text}};
@define-color theme_text_color {{text}};
@define-color theme_bg_color {{bg}};
@define-color theme_base_color {{surface}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{on_accent}};
@define-color insensitive_bg_color {{bg_alt}};
@define-color insensitive_fg_color {{muted}};
@define-color insensitive_base_color {{bg_alt}};
@define-color theme_unfocused_fg_color {{subtext}};
@define-color theme_unfocused_text_color {{text}};
@define-color theme_unfocused_bg_color {{bg}};
@define-color theme_unfocused_base_color {{surface}};
@define-color theme_unfocused_selected_bg_color {{surface_alt}};
@define-color theme_unfocused_selected_fg_color {{text}};
@define-color borders {{border}};
@define-color unfocused_borders {{border}};
@define-color warning_color {{orange}};
@define-color error_color {{red}};
@define-color success_color {{green}};

window,
dialog,
.background {
    background-color: {{bg}};
    color: {{text}};
}

headerbar,
.titlebar,
toolbar,
.primary-toolbar {
    background-image: none;
    background-color: {{bg_alt}};
    color: {{text}};
    border-bottom: 1px solid {{border}};
    box-shadow: none;
}

entry {
    background-image: none;
    background-color: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{radius_small}}px;
    caret-color: {{accent}};
}

entry:focus {
    border-color: {{accent}};
    box-shadow: 0 0 0 2px {{accent:a30}};
}

button {
    background-image: none;
    background-color: {{surface_alt}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{radius_small}}px;
    box-shadow: none;
}

button:hover {
    background-color: {{border}};
}

button:active,
button:checked,
button.suggested-action {
    background-color: {{accent}};
    border-color: {{accent}};
    color: {{on_accent}};
}

notebook,
notebook > stack {
    background-color: {{bg}};
    border-color: {{border}};
}

notebook > header {
    background-color: {{bg_alt}};
    border-color: {{border}};
}

notebook > header > tabs > tab {
    color: {{subtext}};
    padding: 4px 12px;
    border-radius: {{radius_small}}px;
}

notebook > header > tabs > tab:checked {
    background-color: {{surface_alt}};
    color: {{text}};
}

treeview.view,
iconview,
.view,
textview text {
    background-color: {{surface}};
    color: {{text}};
}

treeview.view:selected,
iconview:selected,
.view:selected,
row:selected {
    background-color: {{accent}};
    color: {{on_accent}};
    border-radius: {{radius_small}}px;
}

treeview.view header button {
    background-color: {{bg_alt}};
    color: {{subtext}};
    border-radius: 0;
}

scrolledwindow {
    border-color: {{border}};
}

paned > separator,
separator {
    min-width: 1px;
    min-height: 1px;
    background-color: {{border}};
    background-image: none;
}

placessidebar,
placessidebar list,
.sidebar,
.sidebar .view {
    background-color: {{bg_alt}};
    color: {{text}};
}

menu,
.menu,
.context-menu,
popover {
    background-color: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{radius}}px;
    padding: 4px;
}

menuitem {
    border-radius: {{radius_small}}px;
    padding: 5px 10px;
}

menuitem:hover {
    background-color: {{accent}};
    color: {{on_accent}};
}

statusbar {
    background-color: {{bg_alt}};
    color: {{subtext}};
    border-top: 1px solid {{border}};
}

statusbar frame,
statusbar frame > border {
    border: none;
}

scrollbar {
    background-color: transparent;
    border: none;
}

scrollbar slider {
    min-width: 6px;
    min-height: 6px;
    background-color: {{muted:a50}};
    border-radius: 99px;
}

scrollbar slider:hover {
    background-color: {{muted}};
}
